{
  "name": "driving-school-platform",
  "version": "1.0.0",
  "description": "Multi-tenant driving school management platform",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"cd client && npx vite\"",
    "build": "cd client && npx vite build",
